# ─────────────────────────────────────────────────────────────
# GM 통합관리 설정 · scripts/setup.sh 가 처음 한 번 자동으로 채웁니다
# ─────────────────────────────────────────────────────────────

# 웹앱 포트 (브라우저 접속: http://서버IP:8080)
WEB_PORT=8080

# 수파베이스 키 (~/supabase/docker/.env 의 ANON_KEY · SERVICE_ROLE_KEY)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 컨테이너에서 본 수파베이스 주소 (같은 서버면 그대로)
SUPABASE_INTERNAL_URL=http://host.docker.internal:8000

# 비워두면 브라우저는 같은 주소의 /sb 로 수파베이스에 접속 (권장)
GM_PUBLIC_SUPABASE_URL=

# 기본 관리자 (처음 한 번 만들 때만 사용)
ADMIN_USERNAME=gmconst
ADMIN_TEMP_PASSWORD=gmconst

# 수파베이스 docker 폴더 (마이그레이션 · 백업 스크립트용)
SUPABASE_DIR=/home/jongho/supabase/docker
SUPABASE_DB_CONTAINER=supabase-db

# ── 회의록 ──────────────────────────────────────────────────
# 녹음 받아쓰기 서버 켜기 (끄려면 이 줄을 지우거나 비우기)
COMPOSE_PROFILES=stt
# 받아쓰기 모델: large-v3-turbo(정확 · 기본) / medium / small(빠름 · 덜 정확)
WHISPER_MODEL=large-v3-turbo
# 요약 · 손글씨 인식용 Claude API 키 (없으면 받아쓰기까지만 하고 요약은 직접 씀)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ── 라이선스 ────────────────────────────────────────────────
# 라이선스 서버 주소와 이 회사의 고객 키 (WORKNIUM 라이선스 관리 화면에서 발급)
#   대표님 홈 서버에서 같이 돌릴 때: LICENSE_URL=http://host.docker.internal:8090
LICENSE_URL=
LICENSE_KEY=
# 라이선스 서버(WORKNIUM 쪽) 포트 — COMPOSE_PROFILES 에 license 를 넣었을 때만
LICENSE_PORT=8090
