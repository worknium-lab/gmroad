# GM 통합관리 · 웹 서버
#   /        → 웹앱 (SPA)
#   /api/    → 관리 API 컨테이너
#   /sb/     → 수파베이스 (Kong 게이트웨이) — 한 주소 · 한 HTTPS로 묶기 위해 같은 서버에서 중계
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  server_name _;
  client_max_body_size 200m;

  root /usr/share/nginx/html;
  index index.html;

  location = /config.js { add_header Cache-Control "no-store"; }
  location = /.well-known/assetlinks.json { default_type application/json; add_header Cache-Control "no-cache"; }   # 안드로이드 앱(TWA) 확인용
  location = /sw.js     { add_header Cache-Control "no-cache"; }
  location /assets/     { add_header Cache-Control "public, max-age=31536000, immutable"; }

  location /api/ {
    proxy_pass http://api:3001;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /sb/ {
    proxy_pass ${SUPABASE_INTERNAL_URL}/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_request_buffering off;
  }

  location / { try_files $uri /index.html; }
}
